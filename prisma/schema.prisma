// Prisma Schema for Supabase PostgreSQL Database

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  password  String
  name      String
  role      String    @default("ADMIN")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  projects  Project[]
  auditLogs AuditLog[]
  memberships ProjectMember[]
  requestedChanges ChangeRequest[] @relation("RequestedChanges")
  reviewedChanges  ChangeRequest[] @relation("ReviewedChanges")

  @@map("users")
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  apiKey       String        @unique @map("api_key")
  userId       String?       @map("user_id") @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  archivedAt   DateTime?     @map("archived_at")
  environments Environment[]
  features          Feature[]
  auditLogs         AuditLog[]
  githubIntegration GithubIntegration?
  changeRequests    ChangeRequest[]
  webhooks          Webhook[]
  members           ProjectMember[]

  @@map("projects")
}

model Environment {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  color         String?        @default("#6B7280")
  sortOrder     Int            @default(1) @map("sort_order")
  requireApproval Boolean      @default(false) @map("require_approval")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  featureStates FeatureState[]
  changeRequests ChangeRequest[]

  @@unique([projectId, slug], map: "idx_env_project_slug")
  @@map("environments")
}

model Feature {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  defaultEnabled Boolean        @default(false) @map("default_enabled")
  githubBranch   String?        @map("github_branch")
  githubPrNumber Int?           @map("github_pr_number")
  archivedAt     DateTime?      @map("archived_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  featureStates  FeatureState[]
  changeRequests ChangeRequest[]

  @@unique([projectId, key], map: "idx_feature_project_key")
  @@map("features")
}

model FeatureState {
  id                String      @id @default(uuid()) @db.Uuid
  featureId         String      @map("feature_id") @db.Uuid
  feature           Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)
  environmentId     String      @map("environment_id") @db.Uuid
  environment       Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  enabled           Boolean     @default(false)
  rolloutPercentage Int         @default(100) @map("rollout_percentage")
  rules             String?     @map("rules")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@unique([featureId, environmentId], map: "idx_feature_env")
  @@map("feature_states")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityId     String   @map("entity_id")
  metadataJson String?  @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model GithubIntegration {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @unique @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoOwner     String   @map("repo_owner")
  repoName      String   @map("repo_name")
  accessToken   String?  @map("access_token")
  defaultBranch String   @default("main") @map("default_branch")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("github_integrations")
}

model ChangeRequest {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId     String       @map("feature_id") @db.Uuid
  feature       Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  environmentId String       @map("environment_id") @db.Uuid
  environment   Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  requesterId   String       @map("requester_id") @db.Uuid
  requester     User         @relation("RequestedChanges", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewerId    String?      @map("reviewer_id") @db.Uuid
  reviewer      User?        @relation("ReviewedChanges", fields: [reviewerId], references: [id], onDelete: SetNull)
  targetState   Boolean      @map("target_state")
  targetRollout Int          @default(100) @map("target_rollout")
  targetRules   String?      @map("target_rules")
  reason        String?
  status        String       @default("PENDING") // PENDING, APPROVED, REJECTED, APPLIED
  createdAt     DateTime     @default(now()) @map("created_at")
  reviewedAt    DateTime?    @map("reviewed_at")

  @@map("change_requests")
}

model Webhook {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String
  secret      String?
  description String?
  events      String    @default("flag.toggle,flag.rollout,flag.archived")
  enabled     Boolean   @default(true)
  lastStatus  Int?      @map("last_status")
  lastTrigger DateTime? @map("last_trigger")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deliveries  WebhookDelivery[]

  @@map("webhooks")
}

model ProjectMember {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?   @map("user_id") @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  role        String    @default("EDITOR") // ADMIN, EDITOR, VIEWER
  status      String    @default("ACTIVE") // ACTIVE, PENDING_INVITE
  inviteToken String?   @map("invite_token")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, email], map: "idx_project_member_email")
  @@map("project_members")
}

model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  webhookId      String    @map("webhook_id") @db.Uuid
  webhook        Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  projectId      String    @map("project_id") @db.Uuid
  eventType      String    @map("event_type")
  payloadJson    String    @map("payload_json") @db.Text
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body") @db.Text
  durationMs     BigInt?   @map("duration_ms")
  success        Boolean   @default(false)
  attemptNumber  Int       @default(1) @map("attempt_number")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("webhook_deliveries")
}

model GithubAppInstallation {
  id              String   @id @default(uuid()) @db.Uuid
  installationId  BigInt   @map("installation_id")
  accountLogin    String   @map("account_login") @db.VarChar(255)
  repoFullName    String   @unique @map("repo_full_name") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("github_app_installations")
}
