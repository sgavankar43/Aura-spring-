#!/bin/sh
# Portable Maven Wrapper Script

PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done

PRGDIR=`dirname "$PRG"`
BASE_DIR=`cd "$PRGDIR" >/dev/null 2>&1 && pwd`

if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi

MAVEN_DIR="$BASE_DIR/.mvn/wrapper/apache-maven-3.9.8"

if [ ! -f "$MAVEN_DIR/bin/mvn" ]; then
    echo "Global 'mvn' not found. Downloading Apache Maven 3.9.8..."
    mkdir -p "$BASE_DIR/.mvn/wrapper"
    ZIP_FILE="$BASE_DIR/.mvn/wrapper/maven.zip"
    curl -s -f -L -o "$ZIP_FILE" "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.8/apache-maven-3.9.8-bin.zip"
    unzip -q "$ZIP_FILE" -d "$BASE_DIR/.mvn/wrapper/"
    rm -f "$ZIP_FILE"
    chmod +x "$MAVEN_DIR/bin/mvn"
fi

exec "$MAVEN_DIR/bin/mvn" "$@"
