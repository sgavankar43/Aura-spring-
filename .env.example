# Neon PostgreSQL Configuration for Aura Platform

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-cool-king-bd2dv5cs-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=[YOUR_NEON_PASSWORD]

# Prisma Datasource URL
DATABASE_URL=postgresql://neondb_owner:[YOUR_NEON_PASSWORD]@ep-cool-king-bd2dv5cs-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Security
JWT_SECRET=aura_secret_key_which_should_be_at_least_256_bits_long_for_security_and_production_grade_deployment
